*~

# 本地验证产物、历史归档与开发工具
/outputs/
/local-archive/
/待删除/
/tools/*
!/tools/generate-language-files.cjs
!/tools/verify-language-files.cjs
!/tools/verify-locale.cjs
!/tools/test-language-generation.cjs

# 本机环境配置；共享的 gradle.properties 仍需提交
/.env
/.env.*
!/.env.example
!/.env.template
/local.properties

# 文档按受众区分；对外文档可被 Git 跟踪，本地规则不发布
/docs/*
!/docs/README.md
!/docs/开发者查阅/
!/docs/开发者查阅/**
!/docs/玩家查阅/
!/docs/玩家查阅/**
/docs/本地开发复用/
